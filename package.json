{
  "name": "growx-chitra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "site:dev": "astro dev",
    "site:build": "astro build",
    "site:preview": "astro preview",
    "ops:dev": "vite ops",
    "ops:build": "vite build ops",
    "ops:preview": "vite preview ops",
    "ops:typecheck": "tsc -p ops/tsconfig.json --noEmit",
    "typecheck": "tsc --noEmit && tsc -p ops/tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests",
    "deploy": "wrangler deploy",
    "validate:worker": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply growx-chitra-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply growx-chitra-db --remote"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "hono": "^4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "astro": "^7.3.5",
    "eslint": "^9.0.0",
    "miniflare": "5.20261001.0-alpha",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.0.0"
  }
}
